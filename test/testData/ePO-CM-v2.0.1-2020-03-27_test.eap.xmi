						</ownedAttribute>
						<ownedAttribute xmi:type="uml:Property" xmi:id="EAID_dst0829E5_E280_4824_8181_07AEFB68268C" name="epo:hasAdditionalInformationProvidedBy" association="EAID_D30829E5_E280_4824_8181_07AEFB68268C">
							<type xmi:idref="EAID_029FD14D_C413_41b1_81DD_DA4802D8A322"/>
