					</attribute>
					<attribute xmi:idref="EAID_55D6EC2E_9F28_4a02_BA13_F8CED442A9DB" name="epo:ContractorLegalFormRequirement" scope="Public">
						<initial/>
						<documentation value="A specific legal entity must be taken up by a tenderer composed of a group of economic operators once it has been awarded a contract.&#xA;&#xA;Additional information: this may be applied in the case of groups (e.g. a consortium) where the requirement is that they have to formalise the relationship of the group members as a legal entity itself once the contract is awarded.&#xA;&#xA;WG Approval 2019-01-29&#xA;"/>
						<model ea_localid="873" ea_guid="{55D6EC2E-9F28-4a02-BA13-F8CED442A9DB}"/>
