				<packagedElement xmi:type="uml:Dependency" xmi:id="EAID_A6417A8A_EBC5_410a_BB66_4A8945BCDA0A" supplier="EAID_5E823103_AEAB_4097_89EE_1E1871430712" client="EAID_260EBAD1_7AC3_44ca_B8DF_1AB19E66B864"/>
				<packagedElement xmi:type="uml:Class" xmi:id="EAID_33BEB19C_38FC_4149_A7E3_2D20E14BC9A9" name="ProxyConnector"/>
				<packagedElement xmi:type="uml:Dependency" xmi:id="EAID_0782FAFF_D6F8_47bb_9250_939FD144DE12" supplier="EAID_69CA4BAB_94C3_4a94_91CF_ECDFD24B9757" client="EAID_33BEB19C_38FC_4149_A7E3_2D20E14BC9A9"/>
				<packagedElement xmi:type="uml:Class" xmi:id="EAID_5E823103_AEAB_4097_89EE_1E1871430712" name="ProxyConnector"/>
				<packagedElement xmi:type="uml:Class" xmi:id="EAID_605445FB_A19B_401a_859B_5A213F597D69" name="ProxyConnector"/>
				<packagedElement xmi:type="uml:Dependency" xmi:id="EAID_6D81F842_43D3_4649_A090_5529FD788939" supplier="EAID_0D9E0560_94F1_4eac_9649_2939D9D499CD" client="EAID_605445FB_A19B_401a_859B_5A213F597D69"/>
				<packagedElement xmi:type="uml:Class" xmi:id="EAID_69CA4BAB_94C3_4a94_91CF_ECDFD24B9757" name="ProxyConnector"/>
				<packagedElement xmi:type="uml:Class" xmi:id="EAID_6F8406BA_A642_41c9_849F_7745A3E4ACD2" name="ProxyConnector"/>
				<packagedElement xmi:type="uml:Dependency" xmi:id="EAID_EF1BCD69_04E5_450e_ADD8_3F4CB0B6DC62" supplier="EAID_1FE941B1_1EB8_469e_B368_69CD7C1553C0" client="EAID_6F8406BA_A642_41c9_849F_7745A3E4ACD2"/>
				<packagedElement xmi:type="uml:Class" xmi:id="EAID_B1AFBFC7_E8BD_4ac4_92E6_B685996E4195" name="ProxyConnector"/>
				<packagedElement xmi:type="uml:Class" xmi:id="EAID_B9776EDC_092A_4108_8BBC_655A46D9ED7F" name="epo :Procedure"/>
				<packagedElement xmi:type="uml:Class" xmi:id="EAID_CEBA052A_904D_47de_B1D2_E214E1D0F24A" name="ProxyConnector"/>
				<packagedElement xmi:type="uml:Dependency" xmi:id="EAID_F264C49C_100F_4c00_914F_A4FAE2916DB0" supplier="EAID_B1AFBFC7_E8BD_4ac4_92E6_B685996E4195" client="EAID_CEBA052A_904D_47de_B1D2_E214E1D0F24A"/>
				<packagedElement xmi:type="uml:Package" xmi:id="EAPK_DF19ED10_DFE1_4304_B67F_605B4FF70A4F" name="epo">
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_FF58CD49_7B0F_45fb_9AA0_4619B791FFA1" body="The property linking Tender and Tenderer (submits/is submitted by) shall not be used to get to the Winner from the Contract. Instead &quot;refers to signatory party Winner&quot; MUST be used.&#xA;">
						<annotatedElement xmi:idref="EAID_6CF7585A_9930_48b9_B867_33406CC7CE66"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_F20397E5_7B77_494a_A32D_02DCB62FC00E" body="Participant Name and Participation Payment is expected only when the Design Contest Type is &quot;RESTRICTED&quot;.">
						<annotatedElement xmi:idref="EAID_44E7963D_28F5_4263_835A_24C87816F40C"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_D3F532F0_FFDC_4f3c_A4EB_4221BD8FAB69" body="Beware that the indivIuals of Framework Agreements that are Techniques are different from the individuals of Framework Agreements that are contracts. They are used for different purposes and in different moments. &#xA;&#xA;The lifecycle of Techniques are different from the legal life-cycle of Contracts. These two periods are used in different moments and different purposes, but they're dependent and rules need to be drafted to control that they are not inconsistent.&#xA;&#xA;Examples: &#xA;&#xA;In other words,&#xA;&#xA;the property &quot;has Validity Period&quot; is &quot;reserved to&quot; Technicques, to explain the valid duration of the technique, whilst the &quot;has Duration&quot; property domain is &quot;Contract&quot;.&#xA;">
						<annotatedElement xmi:idref="EAID_D2862D88_92C5_4206_B142_36CDBA0095B8"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_D25FEE50_EFB0_4b6c_9573_6B6587B07AF1" body="We may need a class Variant that identifies the variant.">
						<annotatedElement xmi:idref="EAID_811D4703_55F7_4d6e_B8D8_207479C15419"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_C4D558FE_672E_46a4_8939_B823C6CE03D5" body="Participant Name and Participation Payment is expected only when the Design Contest Type is &quot;RESTRICTED&quot;.&#xA;">
						<annotatedElement xmi:idref="EAID_952A6222_7ED2_4ca4_A084_E51BAA1CF00D"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_ACDF2B67_D966_42d1_B939_433E663BE246" body="All Sub-classes of epo:Value are disjoint.">
						<annotatedElement xmi:idref="EAID_1F273DD7_0EFA_43d2_9B44_2FCDD6AB5C9D"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_A45FFCE5_1AD6_400d_9E63_B6E56E8BFE09" body="DO NOT FORGET LINKING THE PIN CFC AND THE DPS. See also Issues #212 and #213.">
						<annotatedElement xmi:idref="EAID_5983899F_3291_4d88_9CAC_77BD3A82D0D0"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_82787FF7_E9F7_433d_80CE_21589096DB7F" body="We have added a Competition Termination Indicator element to the Procedure class...We have a &quot;parking spot&quot; asking whether the indicator in the Procedure class could be reused also for the DPS, and therefor the attribute DPS Termintation could be removed from here.">
						<annotatedElement xmi:idref="EAID_C06EA401_3F55_4448_B4FF_BB7EA510A155"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_7C230BD5_A8EB_45a4_BA13_97788373E799" body="We have deleted the Reserved Contract Type (Code) property from the Post Award Terms. Instead we have defined a new class named &quot;Participation Criterion&quot; (see diagram &quot;Procurement Criterion&quot; for details).&#xA;&#xA;WG decision 2019-01-16&#xA;">
						<annotatedElement xmi:idref="EAID_40588AD6_810D_4fd6_BA64_B05755E636F2"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_6488EC5F_D8E1_4ccd_BEF7_84F4494CCD0F" body="To verify if the accessibility criteria should be here or whether it should be in Procurement, Award, Selection or Participation Criterion.&#xA;&#xA;Keeping the accessibility criteria herein we put an  extra burden on the developers as they probably would expect them linked to the &quot;Strategic Procurement&quot; class instead, which is the place where the eForms puts it.&#xA;&#xA;">
						<annotatedElement xmi:idref="EAID_F5AE8AA9_91EE_4cb3_AE98_14D4AF1A77C1"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_6404F65E_7F39_4e8c_81E1_F29696E8AE9C" body="PLEASE DO NOT FORGET THAT THE EVALUATION IS NOT ONLY ABOUT TENDERS, BUT REQUESTS FOR PARTICIPATION CAN ALSO BE ASSESSED BY THE CA.&#xA;&#xA;We will have to model this when analysing the eEvaluation. Please see:&#xA;&#xA;- Issue #213 about DPS, and&#xA;- Directive 24, Article 34, namely paragraphs 2 and 5">
						<annotatedElement xmi:idref="EAID_F11BD59C_AA64_47f2_89FC_FCAA78104C30"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_60007273_E0ED_469c_8BBA_2466CA323E8A" body="When analysing the Awarding phase we need to heed attention to the fact that DPS has specific requirements that are dictated by the Contract (and that may not have been notified in the Contract Notice). These requirements would affect the delivery terms, for example.&#xA;&#xA;TO BE DISCUSSED AND RE-ANALYSED. This is also being analysed by NO's Lawyers.&#xA;">
						<annotatedElement xmi:idref="EAID_8E2C2A24_9951_4306_A9FB_28757AF26136"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_4E62BBAD_35F9_49ac_84B6_69B7A970A56B" body="From Directive 24: &#xA;&#xA;Contracting authorities should conduct such a comparative assessment by first determining which tenders best fulfil the award criteria laid down for each individual lot and then comparing it with the tenders submitted by a particular tenderer for a specific combination of lots">
						<annotatedElement xmi:idref="EAID_2046EF02_69A1_4fa0_BF42_2A6E50CAF4E6"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_2E68CEA9_7DAC_4eeb_A3F3_29CE4240543A" body="Recital (79) mentions explicitely that the evaluation is done per lot. The concept of &quot;group&quot; cannot actually be linked to the Tender as it refers to the combination of lots at evaluation time for award criteria used for comparative assessment between the tenders with combined lots and tenders with individual lots.&#xA;&#xA;">
						<annotatedElement xmi:idref="EAID_2046EF02_69A1_4fa0_BF42_2A6E50CAF4E6"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_218DA2CF_3CE7_41d9_B5F4_A1BE4E5CDC16" body="eFroms calls this class &quot;Tender&quot;.">
						<annotatedElement xmi:idref="EAID_811D4703_55F7_4d6e_B8D8_207479C15419"/>
					</ownedComment>
					<ownedComment xmi:type="uml:Comment" xmi:id="EAID_20EE7E9B_2227_439d_B104_0ADEC158F26E" body="Check if it can be used within all notices or wether it needs to be at lower notice level. Also to be checked wether it is legal to not list the buyers.">
						<annotatedElement xmi:idref="EAID_17578598_53B9_4a60_AA0A_7CBE2D9B810A"/>
					</ownedComment>
					<packagedElement xmi:type="uml:Class" xmi:id="EAID_75BCD9B6_2430_48ad_9EC7_90D2BE971F58" name="epo:AccessTerms">
						<ownedAttribute xmi:type="uml:Property" xmi:id="EAID_08E88573_F7A6_42d3_8527_025EA7C4ECE9" name="epo:SomeProcurementDocumentsRestricted">
