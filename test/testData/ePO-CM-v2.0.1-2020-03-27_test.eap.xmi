				<attributes>
					<attribute xmi:idref="EAID_1771F650_29F8_4a16_B44E_4C1AEC28D946" name="epo:FrameworkAgreementType" scope="Public">
						<initial/>
						<documentation value="The form of framework agreement used in a procurement procedure.&#xA;&#xA;Addition information:&#xA;&#xA;A concept to distinguish the different types of framework agreement, which are: &#xA;1. Framework agreement without reopening of competition,&#xA;2. Framework agreement with reopening of competition, or &#xA;3. Framework agreement partly without reopening of competition.&#xA;&#xA;WG Approval 19/09/2019 &#xA;&#xA;"/>
						<model ea_localid="882" ea_guid="{1771F650-29F8-4a16-B44E-4C1AEC28D946}"/>
