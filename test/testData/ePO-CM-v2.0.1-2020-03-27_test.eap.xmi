			<diagram xmi:id="EAID_DBE69433_BC69_4bc8_9E2D_6F109729C6C8">
				<model package="EAPK_6B65084A_798D_4f35_BA8F_EF75ACEBC684" localID="23" owner="EAPK_6B65084A_798D_4f35_BA8F_EF75ACEBC684"/>
				<properties name="Lots" type="Logical" documentation="&lt;ol&gt;&#xA;	&lt;li&gt;A Lot is one of the parts into which a Procurement Procedure is divided.&lt;/li&gt;&#xA;	&lt;li&gt;One or more lots may aim at one or more Contract.&lt;/li&gt;&#xA;	&lt;li&gt;When preparing the Procurement Projects, Lots may be grouped.&lt;/li&gt;&#xA;	&lt;li&gt;Tenderers prepare their Tender for one or more Lots.&lt;/li&gt;&#xA;	&lt;li&gt;The Procuring Entity apply Selection and Award Criteria to one or more Lots or Group of Lots.&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&#xA;&lt;a href=&quot;$imageman://id=1263871221;mdg=Global;name=Legend.png;type=Bitmap;&quot;&gt;&lt;font color=&quot;#0000ff&quot;&gt;&lt;u&gt;Legend.png&lt;/u&gt;&lt;/font&gt;&lt;/a&gt; "/>
