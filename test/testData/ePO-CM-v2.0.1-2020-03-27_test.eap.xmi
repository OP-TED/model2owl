				<properties documentation="We have added a Competition Termination Indicator element to the Procedure class...We have a &quot;parking spot&quot; asking whether the indicator in the Procedure class could be reused also for the DPS, and therefor the attribute DPS Termintation could be removed from here." isSpecification="false" sType="Note" nType="0" scope="public"/>
