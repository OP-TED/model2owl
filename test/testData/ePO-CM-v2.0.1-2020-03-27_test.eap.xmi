			<element xmi:idref="EAID_FA070646_D88B_493f_96AB_8417E2069155" xmi:type="uml:Class" name="epo:FrameworkAgreementTerms" scope="public">
				<model package="EAPK_DF19ED10_DFE1_4304_B67F_605B4FF70A4F" tpos="0" ea_localid="666" ea_eleType="element"/>
				<properties documentation="Reason for extending time limits.&#xA;&#xA;Additional Information: in exceptional cases related, for example, to framework agreements that exceed the legal limits, these limits need to be justified.. (Four years in the case of the general procurement directive, seven years in the case of the defence directive, and eight years in the case of the sectoral directive.).&#xA;&#xA;WG Approval 2019-19-02&#xA;" isSpecification="false" sType="Class" nType="0" scope="public" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
				<project author="estaromi" version="1.0" phase="1.0" created="2019-02-06 14:47:50" modified="2020-03-11 16:22:47" complexity="1" status="Proposed"/>
