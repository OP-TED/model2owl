				<model ea_localid="1291"/>
				<properties ea_type="Association" direction="Source -&gt; Destination"/>
				<modifiers isRoot="false" isLeaf="false"/>
				<parameterSubstitutions/>
				<documentation value="The maximum value which can be spent through all the framework agreements announced in this notice, including options and renewals of contracts.&#xA;&#xA;Additional information:&#xA;&#xA;The value provided is a threshold value that implicity means that it cannot be exceeded however it may not be reached during the execution of a contract.&#xA;&#xA;The Framework Agreements in a CAN are to be traced back and added to provide this value. The path to get the value of an individual Framework Agreement is:&#xA;&#xA;CAN isA Notice,&#xA;CAN notifiesAwardResult AwardDecision,&#xA;AwardDecision refersTo Lot,&#xA;Lot uses Technique, &#xA;FrameworkAgreement isA Technique,&#xA;FrameworkAgreement hasAwardedValue ProcurementValue .&#xA;&#xA;WG Approval 03/12/2019&#xA;&#xA;"/>
				<appearance linemode="3" linecolor="-1" linewidth="0" seqno="0" headStyle="0" lineStyle="0"/>
				<labels rb="0..1" rt="+epo:hasTotalFrameworkValue"/>
