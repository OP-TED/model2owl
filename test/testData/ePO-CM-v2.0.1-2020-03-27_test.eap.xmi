				<properties documentation="We have deleted the Reserved Contract Type (Code) property from the Post Award Terms. Instead we have defined a new class named &quot;Participation Criterion&quot; (see diagram &quot;Procurement Criterion&quot; for details).&#xA;&#xA;WG decision 2019-01-16&#xA;" isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="estaromi" version="1.0" phase="1.0" created="2019-01-16 15:09:21" modified="2019-01-22 17:10:12" complexity="1" status="Proposed"/>
