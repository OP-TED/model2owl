							<lowerValue xmi:type="uml:LiteralInteger" xmi:id="EAID_LI000005_D282_4a12_98D4_FC46FC4463B9" value="1"/>
							<upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="EAID_LI000006_D282_4a12_98D4_FC46FC4463B9" value="1"/>
							<type xmi:idref="EAJava_dateTime"/>
						</ownedAttribute>
						<ownedAttribute xmi:type="uml:Property" xmi:id="EAID_dst976A4B_0A83_4fbb_9096_5821A8E81375" name="epo:hasDownloadURL" association="EAID_03976A4B_0A83_4fbb_9096_5821A8E81375">
