<?xml version="1.0" encoding="windows-1252"?>
<xmi:XMI xmlns:uml="http://www.omg.org/spec/UML/20131001" xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:umldi="http://www.omg.org/spec/UML/20131001/UMLDI" xmlns:dc="http://www.omg.org/spec/UML/20131001/UMLDC" xmlns:thecustomprofile="http://www.sparxsystems.com/profiles/thecustomprofile/1.0">
	<xmi:Documentation exporter="Enterprise Architect" exporterVersion="6.5"/>
	<uml:Model xmi:type="uml:Model" name="EA_Model">
		<packagedElement xmi:type="uml:Package" xmi:id="EAPK_DB0C4677_88DC_4767_8DE5_76387A40E5AE" name="ePO">
			<packagedElement xmi:type="uml:Package" xmi:id="EAPK_6B65084A_798D_4f35_BA8F_EF75ACEBC684" name="eProcurement Ontology - OP Domain Model">
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_F82B5B0E_97FC_456f_AF61_5CA45AC2F997" body="Business Rules are needed here to control whether it is the CPB or the Buyer who signs the contract.&#xA;">
					<annotatedElement xmi:idref="EAID_AFBFAC8F_6B1F_48b7_A214_E396F63092F4"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_E60C250D_BEA0_4052_9130_FB6B3FC98243" body="A Discussion is currently on-going about when and how the group of Lots may be used.&#xA;&#xA;In principle we see that the group of lots is needed for the EO at tendering time. Before that, the elements that relate to more than one lot, establish their relations trhough the property &quot;applies to multiple&quot; lots meaning that the set of lots that are the &quot;range&quot; of that domain element share the same property.&#xA;&#xA;">
					<annotatedElement xmi:idref="EAID_0EAFC54B_5909_4b72_B3AB_96EF5B3DAF9E"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_D7D3B54E_3C67_46a4_9C38_B930EDAA9B0B" body="Lots are specified in the Procurement Procedure Technical Specifications. ">
					<annotatedElement xmi:idref="EAID_D9990D3C_51ED_4626_9195_C96F98BD3349"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_C7A1B7F3_8278_443b_B532_D90805C17B62" body="See Directive 2014/24/EU Article 5 for the calculation method of the estimated value.">
					<annotatedElement xmi:idref="EAID_EF6D8DA9_F7F6_42e7_88CB_7C8DD20D663D"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_9299E3A4_69FA_486a_85C2_90525F5D8623" body="Beware that the Tender Validity Date (deadline) applies to the Tender but may be predefined by the Procuring Entity. ">
					<annotatedElement xmi:idref="EAID_394D9649_C70C_437b_8DE2_A3943CDEC6CA"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_907B8045_CA5D_410f_8653_A1EED3C278CD" body="There can not be a disjoint between the two classes">
					<annotatedElement xmi:idref="EAID_A163B495_CF0A_46cb_B9FF_7E8F24737233"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_85A230F8_F53F_4797_BACA_86CC739617E0" body="This needs to be reviewed taking into account that the ESPD Response already contains this information.">
					<annotatedElement xmi:idref="EAID_24545C91_D269_4cfe_A646_9A2FDEE01B0F"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_8360F6F1_283C_4f5c_AD07_CC3B5D9D2B8A" body="In the case of a procurement procedure it includes options and renewals."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_73677B29_A51C_4111_B0E5_6907130CD326" body="Where's the evaluationMethodType (1. PASS/FAIL, 2. WEIGHTED)&#xA;">
					<annotatedElement xmi:idref="EAID_1575C133_A836_46c6_B1FD_8B54B4D7F3EB"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_715AEF60_51CE_46d0_89A0_B31D9E18E749" body="Double-click on this link to see the rest of classes associated to Procurement Procedure."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_5A7DBCBA_1B9F_46fb_A6F7_16F7A4C440E4" body="A specific business rule would be needed to control possible inconsistency generated by the concurrence of DocumentRestricted and definesAccessTo properties.">
					<annotatedElement xmi:idref="EAID_75BCD9B6_2430_48ad_9EC7_90D2BE971F58"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_38DE1566_E6FA_4e1c_A290_5410961B59F3" body="All Amount properties use the attribute &quot;currencyID&quot; which, in turn, used the Code List &quot;currency&quot; maintained in the EU Vocabularies site. &#xA;&#xA;See also the diagram &quot;Data Types&quot;">
					<annotatedElement xmi:idref="EAID_1F273DD7_0EFA_43d2_9B44_2FCDD6AB5C9D"/>
					<annotatedElement xmi:idref="EAID_D6EA39C4_A1DD_451d_8107_3B9FC95AECB7"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_360A59D5_B03F_4527_80EF_223C999C3906" body="The Planned Procurement Part Legal Basis should match the Procedure Legal Basis once this is launched.">
					<annotatedElement xmi:idref="EAID_E6781D26_CD82_4c7b_A53A_502157F5F45A"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_1E157B1E_F107_492b_B385_821B904A8FDA" body="We have to work on the naming of the code identifiers, as these code may be taken as representatives of the documents in themselves whilst they are intended to specify to what type of submitable document the deadlines are referred to.&#xA;&#xA;(TO BE FURTHER DISCUSSED)">
					<annotatedElement xmi:idref="EAID_0C79910E_0218_4463_A228_8A5B14708C6D"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_155EADFF_098A_4c04_93B1_DDAB8F552C4B" body="Beware that org:Organization uses the annotation rdf:preferredLabel. This &quot;name&quot; property is defined in the &quot;cagv:&quot; namespace.">
					<annotatedElement xmi:idref="EAID_86BB0717_BF22_48bd_BEC6_0F6337E2FE76"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_10776541_956F_4e91_8E23_3F72EE6474D4" body="The sum of individual lots may not necessarily be equal to the value of its group of lots.&#xA;">
					<annotatedElement xmi:idref="EAID_6D81F842_43D3_4649_A090_5529FD788939"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_0C26140C_B804_42c1_A95F_887E0C28DCDE" body="The cardinality is 0..1 (optional) because the Directives (e.g. Directive 2014/24/EU Annex V) does not oblige to have this data.">
					<annotatedElement xmi:idref="EAID_217C56AC_5F5D_43c4_9830_8E9FA8969896"/>
				</ownedComment>
				<packagedElement xmi:type="uml:Class" xmi:id="EAID_036B683E_9DD6_4381_B839_D520C78EFDE4" name="epo : Procurement Terms"/>
				<packagedElement xmi:type="uml:Class" xmi:id="EAID_0D9E0560_94F1_4eac_9649_2939D9D499CD" name="ProxyConnector"/>
				<packagedElement xmi:type="uml:Class" xmi:id="EAID_1FE941B1_1EB8_469e_B368_69CD7C1553C0" name="ProxyConnector"/>
