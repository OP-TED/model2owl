			<element xmi:idref="EAID_D3F532F0_FFDC_4f3c_A4EB_4221BD8FAB69" xmi:type="uml:Note" scope="public">
				<model package="EAPK_DF19ED10_DFE1_4304_B67F_605B4FF70A4F" tpos="0" ea_localid="689" ea_eleType="element"/>
				<properties documentation="Beware that the indivIuals of Framework Agreements that are Techniques are different from the individuals of Framework Agreements that are contracts. They are used for different purposes and in different moments. &#xA;&#xA;The lifecycle of Techniques are different from the legal life-cycle of Contracts. These two periods are used in different moments and different purposes, but they're dependent and rules need to be drafted to control that they are not inconsistent.&#xA;&#xA;Examples: &#xA;&#xA;In other words,&#xA;&#xA;the property &quot;has Validity Period&quot; is &quot;reserved to&quot; Technicques, to explain the valid duration of the technique, whilst the &quot;has Duration&quot; property domain is &quot;Contract&quot;.&#xA;" isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="jseguraf" version="1.0" phase="1.0" created="2019-02-20 16:43:49" modified="2019-02-20 16:44:10" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
