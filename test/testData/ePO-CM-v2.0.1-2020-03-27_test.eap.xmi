			<element xmi:idref="EAID_86839B9A_F92D_4a34_8E9F_A4A59D3536F3" xmi:type="uml:Class" name="epo:Social" scope="public">
				<model package="EAPK_DF19ED10_DFE1_4304_B67F_605B4FF70A4F" tpos="0" ea_localid="1337" ea_eleType="element"/>
