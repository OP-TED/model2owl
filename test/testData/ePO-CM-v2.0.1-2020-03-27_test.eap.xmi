					<Association xmi:id="EAID_605B0380_1360_42e5_81B8_144F85B0A7EB" start="EAID_49EC0F16_408C_4b28_B611_0048946DC070" end="EAID_E6792665_435C_46ba_87AB_72BC9CB60BDA"/>
					<Generalization xmi:id="EAID_657CE8BE_2717_41d1_B80A_3B15D5AAC373" start="EAID_49EC0F16_408C_4b28_B611_0048946DC070" end="EAID_4B85906E_78A4_4f5a_9AE8_1438AF447827"/>
				</links>
			</element>
			<element xmi:idref="EAID_EF6D8DA9_F7F6_42e7_88CB_7C8DD20D663D" xmi:type="uml:Class" name="epo:ProcurementValue" scope="public">
