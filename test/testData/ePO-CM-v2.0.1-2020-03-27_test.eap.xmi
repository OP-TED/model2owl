			</element>
			<element xmi:idref="EAID_2E68CEA9_7DAC_4eeb_A3F3_29CE4240543A" xmi:type="uml:Note" scope="public">
				<model package="EAPK_DF19ED10_DFE1_4304_B67F_605B4FF70A4F" tpos="0" ea_localid="795" ea_eleType="element"/>
				<properties documentation="Recital (79) mentions explicitely that the evaluation is done per lot. The concept of &quot;group&quot; cannot actually be linked to the Tender as it refers to the combination of lots at evaluation time for award criteria used for comparative assessment between the tenders with combined lots and tenders with individual lots.&#xA;&#xA;" isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="estaromi" version="1.0" phase="1.0" created="2019-06-06 16:25:23" modified="2019-06-06 16:30:11" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="epo"/>
				<links>
					<NoteLink xmi:id="EAID_C9B4B281_611C_4c18_9F39_2A5E8F21FDE3" start="EAID_2E68CEA9_7DAC_4eeb_A3F3_29CE4240543A" end="EAID_2046EF02_69A1_4fa0_BF42_2A6E50CAF4E6"/>
				</links>
			</element>
			<element xmi:idref="EAID_4E62BBAD_35F9_49ac_84B6_69B7A970A56B" xmi:type="uml:Note" scope="public">
				<model package="EAPK_DF19ED10_DFE1_4304_B67F_605B4FF70A4F" tpos="0" ea_localid="787" ea_eleType="element"/>
				<properties documentation="From Directive 24: &#xA;&#xA;Contracting authorities should conduct such a comparative assessment by first determining which tenders best fulfil the award criteria laid down for each individual lot and then comparing it with the tenders submitted by a particular tenderer for a specific combination of lots" isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="estaromi" version="1.0" phase="1.0" created="2019-05-29 12:14:19" modified="2019-05-29 12:15:54" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="epo"/>
				<links>
					<NoteLink xmi:id="EAID_DC5A0C2C_CCFF_4f18_8F5C_89D3E918F093" start="EAID_4E62BBAD_35F9_49ac_84B6_69B7A970A56B" end="EAID_2046EF02_69A1_4fa0_BF42_2A6E50CAF4E6"/>
				</links>
			</element>
			<element xmi:idref="EAID_60007273_E0ED_469c_8BBA_2466CA323E8A" xmi:type="uml:Note" scope="public">
				<model package="EAPK_DF19ED10_DFE1_4304_B67F_605B4FF70A4F" tpos="0" ea_localid="622" ea_eleType="element"/>
				<properties documentation="When analysing the Awarding phase we need to heed attention to the fact that DPS has specific requirements that are dictated by the Contract (and that may not have been notified in the Contract Notice). These requirements would affect the delivery terms, for example.&#xA;&#xA;TO BE DISCUSSED AND RE-ANALYSED. This is also being analysed by NO's Lawyers.&#xA;" isSpecification="false" sType="Note" nType="1" scope="public"/>
				<project author="jseguraf" version="1.0" phase="1.0" created="2018-12-04 16:54:32" modified="2018-12-04 16:55:10" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="epo" relatedlinks="idref1=EAID_8E2C2A24_9951_4306_A9FB_28757AF26136;"/>
			</element>
			<element xmi:idref="EAID_6404F65E_7F39_4e8c_81E1_F29696E8AE9C" xmi:type="uml:Note" scope="public">
				<model package="EAPK_DF19ED10_DFE1_4304_B67F_605B4FF70A4F" tpos="0" ea_localid="824" ea_eleType="element"/>
				<properties documentation="PLEASE DO NOT FORGET THAT THE EVALUATION IS NOT ONLY ABOUT TENDERS, BUT REQUESTS FOR PARTICIPATION CAN ALSO BE ASSESSED BY THE CA.&#xA;&#xA;We will have to model this when analysing the eEvaluation. Please see:&#xA;&#xA;- Issue #213 about DPS, and&#xA;- Directive 24, Article 34, namely paragraphs 2 and 5" isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="estaromi" version="1.0" phase="1.0" created="2019-07-02 15:42:48" modified="2019-07-02 15:45:06" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="epo"/>
				<links>
					<NoteLink xmi:id="EAID_B5953F02_D3A7_42a9_B0CC_1FAC9B4A8A09" start="EAID_6404F65E_7F39_4e8c_81E1_F29696E8AE9C" end="EAID_F11BD59C_AA64_47f2_89FC_FCAA78104C30"/>
				</links>
			</element>
			<element xmi:idref="EAID_6488EC5F_D8E1_4ccd_BEF7_84F4494CCD0F" xmi:type="uml:Note" scope="public">
				<model package="EAPK_DF19ED10_DFE1_4304_B67F_605B4FF70A4F" tpos="0" ea_localid="704" ea_eleType="element"/>
				<properties documentation="To verify if the accessibility criteria should be here or whether it should be in Procurement, Award, Selection or Participation Criterion.&#xA;&#xA;Keeping the accessibility criteria herein we put an  extra burden on the developers as they probably would expect them linked to the &quot;Strategic Procurement&quot; class instead, which is the place where the eForms puts it.&#xA;&#xA;" isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="jseguraf" version="1.0" phase="1.0" created="2019-03-05 15:55:30" modified="2019-04-11 15:37:42" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
